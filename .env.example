EVOGUARD_SECRET_KEY=change-this-secret
EVOGUARD_APP_ENV=development
EVOGUARD_DATABASE_URL=sqlite:///evoguard.db
# Production example:
# EVOGUARD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
EVOGUARD_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://mayedalshehhi.github.io
EVOGUARD_COOKIE_SAMESITE=Lax
EVOGUARD_COOKIE_SECURE=false
EVOGUARD_MAX_UPLOAD_MB=8
EVOGUARD_REPORT_DIR=backend/reports
REACT_APP_API_BASE_URL=http://127.0.0.1:5000
EVOGUARD_DEFAULT_USERNAME=your-private-admin-username
EVOGUARD_DEFAULT_PASSWORD=your-private-admin-password
EVOGUARD_INGEST_API_KEY=change-this-live-ingest-key
EVOGUARD_ANALYST_EMAIL=evoguardzu@gmail.com
EVOGUARD_ENABLE_SCHEDULER=false

# Optional email report delivery
EVOGUARD_EMAIL=
EVOGUARD_EMAIL_PASSWORD=
